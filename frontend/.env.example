# Public CARTO Builder map for the Austin 311 baseline iframe.
# Leave unset until a Public https://clausa.app.carto.com/map/<uuid> exists.
# Never append lat/lng to this URL. The HUD reads live reports from FastAPI instead.
# VITE_CARTO_MAP_URL=

# Regional Cloud API (not a secret). Do not put CARTO_API_ACCESS_TOKEN here.
VITE_CARTO_API_BASE_URL=https://gcp-us-east1.api.carto.com

# Optional CARTO Basemaps CDN key (different from the Cloud API Access Token).
# Without it the live overlay uses OpenStreetMap tiles. Never commit the value.
# VITE_CARTO_BASEMAPS_KEY=
