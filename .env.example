# CivicPulse Mesh needs no API key for the local or container demo.
# Classification is civicpulse-heuristic. Do not put secret values in git.
PORT=43211
FRONTEND_DIST=frontend/dist
MODEL_NAME=civicpulse-heuristic
CORS_ORIGINS=http://127.0.0.1:43211

# Optional later, for a hosted Gemini classifier. Leave unset.
# GEMINI_API_KEY=

# Public CARTO Cloud org (not a secret). Token values stay out of git.
CARTO_API_BASE_URL=https://gcp-us-east1.api.carto.com
# CARTO_API_ACCESS_TOKEN=

# Public Builder map. Set in frontend/.env for Vite. Leave empty until published.
# VITE_CARTO_MAP_URL=
# VITE_CARTO_BASEMAPS_KEY=
